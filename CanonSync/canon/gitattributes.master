# ==========================================================================
# Managed by CanonSync — canonical .gitattributes (block mode)
# Source of truth: canon/gitattributes.master · Do not hand-edit inside a synced repo.
# ==========================================================================

# Canonical Git attributes. Add repo-specific rules (e.g. Git LFS
# tracking for large binaries) BELOW the managed block.

# Normalize line endings: let Git decide, checkout LF.
* text=auto eol=lf

# Explicit text types.
*.py   text
*.md   text
*.txt  text
*.json text
*.yml  text
*.yaml text
*.cfg  text
*.ini  text
*.toml text
*.sh   text eol=lf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Explicit binary types (never normalized or diffed as text).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.7z   binary
*.exe  binary
*.dll  binary
*.so   binary
*.dylib binary
*.sqlite binary
*.db   binary

# Example Git LFS tracking (uncomment per repo that ships large assets):
# *.zip filter=lfs diff=lfs merge=lfs -text
# *.pdf filter=lfs diff=lfs merge=lfs -text
