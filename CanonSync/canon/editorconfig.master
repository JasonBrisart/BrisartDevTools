# ==========================================================================
# Managed by CanonSync — canonical .editorconfig (block mode)
# Source of truth: canon/editorconfig.master · Do not hand-edit inside a synced repo.
# ==========================================================================

# Canonical EditorConfig rules. See https://editorconfig.org
# Add repo-specific overrides BELOW the managed block.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.py]
indent_size = 4

[*.{js,jsx,ts,tsx,json,jsonc,yml,yaml,toml,html,css}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
